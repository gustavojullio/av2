<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:minHeight="64dp"
        android:textColor="@color/black"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="(10+2)×3" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:minHeight="64dp"
        android:text="0"
        android:textColor="@color/purple_700"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvExpression" />

    <GridLayout
        android:id="@+id/buttonsGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:rowCount="6"
        android:useDefaultMargins="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResult">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/CalcButtonAction"
            android:text="C" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/CalcButtonAction"
            android:text="⌫" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenParen"
            style="@style/CalcButtonAction"
            android:text="(" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseParen"
            style="@style/CalcButtonAction"
            android:text=")" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7"
            style="@style/CalcButtonNumber"
            android:text="7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8"
            style="@style/CalcButtonNumber"
            android:text="8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9"
            style="@style/CalcButtonNumber"
            android:text="9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDivide"
            style="@style/CalcButtonOperator"
            android:text="÷" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            style="@style/CalcButtonNumber"
            android:text="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            style="@style/CalcButtonNumber"
            android:text="5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6"
            style="@style/CalcButtonNumber"
            android:text="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMultiply"
            style="@style/CalcButtonOperator"
            android:text="×" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            style="@style/CalcButtonNumber"
            android:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            style="@style/CalcButtonNumber"
            android:text="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            style="@style/CalcButtonNumber"
            android:text="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMinus"
            style="@style/CalcButtonOperator"
            android:text="-" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn0"
            style="@style/CalcButtonNumber"
            android:text="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDot"
            style="@style/CalcButtonNumber"
            android:text="." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEquals"
            style="@style/CalcButtonEquals"
            android:text="=" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlus"
            style="@style/CalcButtonOperator"
            android:text="+" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
