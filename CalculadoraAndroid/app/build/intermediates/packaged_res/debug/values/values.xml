<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="action_background">#FFE0B2</color>
    <color name="black">#000000</color>
    <color name="equals_background">#6750A4</color>
    <color name="number_background">#F1F3F4</color>
    <color name="operator_background">#F2E7FE</color>
    <color name="purple_200">#BB86FC</color>
    <color name="purple_500">#6200EE</color>
    <color name="purple_700">#3700B3</color>
    <color name="teal_200">#03DAC5</color>
    <color name="teal_700">#018786</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Calculadora</string>
    <string name="invalid_expression">Expressão inválida</string>
    <style name="CalcButtonAction" parent="CalcButtonBase">
        <item name="backgroundTint">@color/action_background</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="CalcButtonBase" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="CalcButtonEquals" parent="CalcButtonBase">
        <item name="backgroundTint">@color/equals_background</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="CalcButtonNumber" parent="CalcButtonBase">
        <item name="backgroundTint">@color/number_background</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="CalcButtonOperator" parent="CalcButtonBase">
        <item name="backgroundTint">@color/operator_background</item>
        <item name="android:textColor">@color/purple_700</item>
    </style>
    <style name="Theme.Calculadora" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor" ns1:targetApi="l">@color/purple_700</item>
    </style>
</resources>