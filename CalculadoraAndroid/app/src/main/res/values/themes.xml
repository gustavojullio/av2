<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Calculadora" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/purple_700</item>
    </style>

    <style name="CalcButtonBase" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalcButtonNumber" parent="CalcButtonBase">
        <item name="backgroundTint">@color/number_background</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CalcButtonOperator" parent="CalcButtonBase">
        <item name="backgroundTint">@color/operator_background</item>
        <item name="android:textColor">@color/purple_700</item>
    </style>

    <style name="CalcButtonAction" parent="CalcButtonBase">
        <item name="backgroundTint">@color/action_background</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CalcButtonEquals" parent="CalcButtonBase">
        <item name="backgroundTint">@color/equals_background</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
